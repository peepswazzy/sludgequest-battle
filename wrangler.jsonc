{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sludgequest-battle",
  "main": "worker.js",
  "compatibility_date": "2026-08-31",
  "durable_objects": {
    "bindings": [
      {
        "name": "BATTLE_ROOM",
        "class_name": "BattleRoom"
      }
    ]
  },
  "exports": {
    "BattleRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}